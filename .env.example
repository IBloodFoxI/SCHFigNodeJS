# Скопируй в .env и заполни.

# ОБЯЗАТЕЛЬНО. Тот же самый секрет, что в config.yml плагина (auth.secret).
# Им плагин подписывает токены, а этот сервис их проверяет. Больше между ними
# ничего общего нет — ни базы, ни порядка запуска.
FIGURA_SECRET=

# Где слушать внутри контейнера. Наружу выставляет docker-compose.
FIGURA_HOST=0.0.0.0
FIGURA_PORT=8080

# Куда складывать аватары, профили и кэш ресурсов. Это volume из compose.
FIGURA_DATA_DIR=/data

# Потолок на размер аватара, байт. Реальный лимит игрока приезжает подписанным
# внутри токена — его задаёт плагин, потому что только он знает про группы прав.
# Здесь просто предохранитель: ставь заметно выше плагинного и забудь.
FIGURA_MAX_AVATAR_SIZE_CEILING=4194304

# Байт/сек, отдаётся клиенту в /api/limits, если в токене нули.
FIGURA_UPLOAD_RATE=1000000
FIGURA_DOWNLOAD_RATE=1000000

# Сообщение в гардеробе: JSON-компонент Minecraft либо простой текст.
FIGURA_MOTD={"text":"ServerChichi","color":"aqua"}

# Должно совпадать с mod_version сборки SCHFigura, иначе игроки будут ловить
# тост про несуществующее обновление.
FIGURA_VERSION_RELEASE=0.1.6
FIGURA_VERSION_PRERELEASE=0.1.6

# Значки и эмодзи Figura: тянутся с официального бэкенда один раз и кэшируются.
# Выключи, если нет исходящего интернета — тогда положи файлы в /data/assets руками.
FIGURA_ASSETS_PROXY=true
FIGURA_ASSETS_UPSTREAM=https://figura.moonlight-devs.org/api

# Пинг вебсокетов раз в N секунд. Соединение простаивает, пока никто не шлёт
# Lua-пинги, а Cloudflare и nginx рвут простаивающие. За Cloudflare не выключать.
FIGURA_WS_KEEPALIVE_SECONDS=30

# Подробный лог каждого запроса. Шумно, но незаменимо при первой настройке.
FIGURA_DEBUG=false
