# Скопируй в .env и заполни. Отсюда читают и сервис, и docker-compose.

# ---------------------------------------------------------------------------
#  Развёртывание
# ---------------------------------------------------------------------------

# Домен, на котором висит бэкенд. Должен совпадать с backend-address в конфиге
# плагина FiguraLink — из него клиент собирает https://<домен>/api и wss://<домен>/ws.
FIGURA_DOMAIN=figura.serverchichi.online

# Образ. Собирается GitHub Action при пуше в main, на сервере компилировать нечего.
# Для отката поставь конкретный тег: ghcr.io/ibloodfoxi/schfignodejs:sha-abc1234
FIGURA_IMAGE=ghcr.io/ibloodfoxi/schfignodejs:latest

# Entrypoint основного Traefik, на котором висит TLS.
TRAEFIK_ENTRYPOINT=websecure

# ---------------------------------------------------------------------------
#  Обязательное
# ---------------------------------------------------------------------------

# Тот же самый секрет, что в config.yml плагина FiguraLink (auth.secret).
# Им плагин подписывает токены, а сервис их проверяет. Больше между ними
# ничего общего нет — ни базы, ни порядка запуска.
FIGURA_SECRET=

# ---------------------------------------------------------------------------
#  Сервис
# ---------------------------------------------------------------------------

FIGURA_HOST=0.0.0.0
FIGURA_PORT=8080

# Куда складывать аватары, профили и кэш ресурсов. Это volume из compose.
FIGURA_DATA_DIR=/data

# Потолок на размер аватара, байт. Реальный лимит игрока приезжает подписанным
# внутри токена — его задаёт плагин, потому что только он знает про группы прав.
# Здесь просто предохранитель: ставь заметно выше плагинного и забудь.
FIGURA_MAX_AVATAR_SIZE_CEILING=4194304

# Байт/сек, отдаётся клиенту в /api/limits, если в токене нули.
FIGURA_UPLOAD_RATE=1000000
FIGURA_DOWNLOAD_RATE=1000000

# Сообщение в гардеробе: JSON-компонент Minecraft либо простой текст.
FIGURA_MOTD={"text":"ServerChichi","color":"aqua"}

# Должно совпадать с mod_version сборки SCHFigura, иначе игроки будут ловить
# тост про несуществующее обновление.
FIGURA_VERSION_RELEASE=0.1.6
FIGURA_VERSION_PRERELEASE=0.1.6

# Значки и эмодзи Figura: тянутся с официального бэкенда один раз и кэшируются.
# Выключи, если нет исходящего интернета — тогда положи файлы в /data/assets руками.
FIGURA_ASSETS_PROXY=true
FIGURA_ASSETS_UPSTREAM=https://figura.moonlight-devs.org/api

# Пинг вебсокетов раз в N секунд. Соединение простаивает, пока никто не шлёт
# Lua-пинги, а Traefik и Cloudflare рвут простаивающие. Держи ниже таймаута
# простоя на entrypoint основного Traefik.
FIGURA_WS_KEEPALIVE_SECONDS=30

# ---------------------------------------------------------------------------
#  Очистка места
# ---------------------------------------------------------------------------

# Аватары ушедших игроков — единственное, что растёт без ограничений: один файл
# на каждого, кто когда-либо заходил. Перезаливка аватара место НЕ занимает,
# файл перезаписывается поверх.
#
# Активность считается по обращениям с токеном этого игрока, а не по скачиваниям:
# клиенты кэшируют аватары по хэшу, и файл активного игрока может неделями
# никем не запрашиваться.
FIGURA_CLEANUP_ENABLED=true
FIGURA_CLEANUP_INACTIVE_DAYS=90
FIGURA_CLEANUP_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
#  Администрирование
# ---------------------------------------------------------------------------

# Включает /api/admin/* — ручное удаление, принудительная очистка, статистика.
# Пусто — маршруты выключены целиком и отвечают 404. Это НЕ токен игрока,
# делай его длинным и не свети.
FIGURA_ADMIN_TOKEN=

# Подробный лог каждого запроса. Шумно, но незаменимо при первой настройке.
FIGURA_DEBUG=false

# ---------------------------------------------------------------------------
#  Резервный путь для немодифицированных клиентов (только лицензия)
# ---------------------------------------------------------------------------

FIGURA_SESSION_AUTH=true
FIGURA_HAS_JOINED_URL=https://sessionserver.mojang.com/session/minecraft/hasJoined
FIGURA_SESSION_TOKEN_TTL_MINUTES=720
